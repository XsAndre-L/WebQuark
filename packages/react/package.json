{
  "name": "@webquark/react",
  "version": "1.0.2",
  "description": "React wrappers for WebQuark Web Components",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
