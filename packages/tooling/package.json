{
  "name": "@webquark/tooling",
  "version": "1.0.2",
  "description": "WebQuark local switching, changelog, versioning and capture developer tooling",
  "repository": {
    "type": "git",
    "url": "https://github.com/XsAndre-L/WebQuark.git",
    "directory": "packages/tooling"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    "./sandbox": {
      "types": "./dist/sandbox/webquark-serve.d.ts",
      "import": "./dist/sandbox/webquark-serve.js",
      "default": "./dist/sandbox/webquark-serve.js"
    },
    "./wq-switch": "./dist/wq-switch/index.cjs",
    "./wq-setup": "./dist/wq-switch/setup.cjs",
    "./changelog": {
      "types": "./dist/changelog/index.d.ts",
      "import": "./dist/changelog/index.js",
      "default": "./dist/changelog/index.js"
    }
  },
  "bin": {
    "wq-switch": "./dist/wq-switch/index.cjs",
    "wq-setup": "./dist/wq-switch/setup.cjs",
    "wq-changelog": "./dist/changelog/cli/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && bun run --cwd ../.. switch:build"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "dependencies": {
    "sharp": "0.35.5"
  }
}
