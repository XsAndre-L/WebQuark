{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "../../src/tooling",
    "outDir": "./dist",
    "declaration": true,
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["../../src/tooling/**/*"],
