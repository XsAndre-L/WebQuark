{
  "name": "@webquark/browser",
  "version": "1.0.2",
  "description": "WebQuark browser components, theme and utilities",
  "repository": {
    "type": "git",
    "url": "https://github.com/XsAndre-L/WebQuark.git",
    "directory": "packages/browser/components"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/webquark/webquark.esm.js",
  "dependencies": {
    "@lucide/icons": "1.54.0",
    "@maplibre/maplibre-gl-leaflet": "0.1.4",
    "leaflet": "1.9.4",
    "leaflet.gridlayer.googlemutant": "0.16.0",
    "maplibre-gl": "6.13.0",
    "supercluster": "^9.1.0"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js",
      "default": "./dist/components/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js",
      "default": "./dist/components/*.js"
    },
    "./dist/components": {
      "import": "./dist/components/index.js",
      "types": "./dist/components/index.d.ts",
      "default": "./dist/components/index.js"
    },
    "./dist/components/*.js": {
      "import": "./dist/components/*.js",
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.js"
    },
    "./dist/webquark/webquark.css": "./dist/webquark/webquark.css",
    "./native-content.css": "./dist/webquark/native-content.css",
    "./dist/*": {
      "import": "./dist/*",
      "types": "./dist/*.d.ts"
    },
    "./loader": {
      "types": "./dist/loader/index.d.ts",
      "import": "./dist/loader/index.js",
      "require": "./dist/loader/index.cjs.js"
    },
    "./components/*.js": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js",
      "default": "./dist/components/*.js"
    },
    "./webquark.css": "./dist/webquark/webquark.css"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run --cwd ../../.. browser:build"
  }
}
