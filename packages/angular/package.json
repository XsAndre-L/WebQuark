{
  "name": "@webquark/angular",
  "version": "1.0.2",
  "description": "Angular directives and wrappers for WebQuark Web Components",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./data-table-cell": {
      "types": "./dist/types/data-table-cell.d.ts",
      "import": "./dist/data-table-cell.js",
      "default": "./dist/data-table-cell.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Purely-IT/WebQuark.git",
    "directory": "packages/angular"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare:generated": "bun run scripts/prepare-generated.ts",
    "verify:drift": "bun run scripts/verify-angular-drift.ts",
    "verify:consumer": "bun run scripts/verify-consumer.ts",
    "verify:compatibility": "bun run scripts/verify-angular-compatibility.ts",
    "verify": "bun run verify:drift && bun run verify:consumer && bun run verify:compatibility",
    "build": "bun run prepare:generated && ngc -p tsconfig.json && bun run verify:consumer && bun run verify:drift"
  },
  "peerDependencies": {
    "@webquark/core": "^1.0.2",
    "@angular/common": "^22.1.7",
    "@angular/core": "^22.1.7",
    "@angular/forms": "^22.1.7",
    "rxjs": "^7.0.0"
  },
  "devDependencies": {
    "@angular/common": "22.1.7",
    "@angular/compiler": "22.1.7",
    "@angular/compiler-cli": "22.1.7",
    "@angular/core": "22.1.7",
    "@angular/forms": "22.1.7",
    "@angular/platform-browser": "22.1.7",
    "rxjs": "7.8.2",
    "typescript": "~6.0.3",
    "zone.js": "~0.15.1"
  },
  "license": "MIT"
}
