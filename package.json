{
  "name": "@webquark/workspace",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/core",
    "packages/browser/components",
    "packages/browser/angular",
    "packages/browser/react",
    "packages/tooling"
  ],
  "scripts": {
    "tooling:update": "bun script/tooling/tooling.ts update",
    "formatter:build": "bun script/tooling/tooling.ts build formatter",
    "formatter:refresh": "bun script/tooling/tooling.ts refresh formatter",
    "theme:generate": "bun scripts/generate-theme.ts",
    "switch:build": "tsc -p src/tooling/wq-switch/tsconfig.json && bun build src/tooling/wq-switch/index.ts src/tooling/wq-switch/setup.ts --outdir=packages/tooling/dist/wq-switch --entry-naming=[name].cjs --target=node --format=cjs",
    "build": "bun run browser:build && bun run tooling:build && bun run core:build",
    "start": "bun run scripts/start-playground.ts",
    "check:playground": "bun scripts/playground-contract.ts && tsc -p src/playground/tsconfig.json",
    "dev": "bun run start",
    "test": "bun run packages:build && STENCIL_PROD=true vitest run",
    "test:watch": "stencil-test --prod --watch --stencil-config packages/browser/components/stencil.config.ts",
    "generate": "stencil generate --config packages/browser/components/stencil.config.ts",
    "packages:build": "bun run build && bun run --cwd packages/browser/react build && bun run --cwd packages/browser/angular build",
    "test:carousel:browsers": "bunx vitest run --project carousel-browsers",
    "pr:verify": "bun run check:prop-order && bun run packages:build && bunx vitest run --project tooling && bunx vitest run --project unit",
    "release:prepare": "bun .github/scripts/publishing/prepare-release.ts",
    "release:verify": "bun .github/scripts/publishing/verify-packages.ts",
    "publish-all": "bun .github/scripts/publishing/publish-packages.ts",
    "align-headers": "bun run scripts/align-headers.ts",
    "check:prop-order": "bun run scripts/component-prop-order/check.ts",
    "browser:build": "bun run formatter:build && bun run theme:generate && bun build src/playground/playground.ts --outfile=.stencil/dist/playground/playground.js --loader .html:text --loader .css:text && stencil build --config packages/browser/components/stencil.config.ts",
    "tooling:build": "bun run --cwd packages/tooling build",
    "core:build": "bun run scripts/build-core.ts"
  },
  "devDependencies": {
    "@stencil/angular-output-target": "^1.5.2",
    "@stencil/core": "^4.45.2",
    "@stencil/react-output-target": "^1.6.4",
    "@stencil/vitest": "^1.15.1",
    "@types/google.maps": "^3.66.5",
    "@types/leaflet": "1.9.22",
    "@types/leaflet.gridlayer.googlemutant": "0.4.11",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.4",
    "@vitest/browser": "4.1.12",
    "@vitest/browser-playwright": "4.1.12",
    "@webquark/react": "workspace:*",
    "playwright": "^1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~6.0.3",
    "vitest": "4.1.12",
    "@lucide/icons": "1.54.0",
    "@maplibre/maplibre-gl-leaflet": "0.1.4",
    "leaflet": "1.9.4",
    "leaflet.gridlayer.googlemutant": "0.16.0",
    "maplibre-gl": "6.13.0",
    "supercluster": "^9.1.0",
    "@webquark/core": "workspace:*",
    "@webquark/browser": "workspace:*",
    "@webquark/tooling": "workspace:*",
    "sharp": "0.35.5",
    "cmd-shim": "8.0.0",
    "read-cmd-shim": "6.0.0"
  },
  "license": "MIT"
}
