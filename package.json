{
  "name": "@webquark/core",
  "version": "1.0.2",
  "description": "WebQuark Core Web Components",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/webquark/webquark.esm.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs.js"
    },
    "./components": {
      "import": "./dist/components/index.js",
      "types": "./dist/components/index.d.ts",
      "default": "./dist/components/index.js"
    },
    "./components/*": {
      "import": "./dist/components/*",
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*"
    },
    "./dist/components": {
      "import": "./dist/components/index.js",
      "types": "./dist/components/index.d.ts",
      "default": "./dist/components/index.js"
    },
    "./dist/components/*.js": {
      "import": "./dist/components/*.js",
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.js"
    },
    "./dist/webquark/webquark.css": "./dist/webquark/webquark.css",
    "./dist/*": {
      "import": "./dist/*",
      "types": "./dist/*.d.ts"
    },
    "./loader": {
      "types": "./dist/loader/index.d.ts",
      "import": "./dist/loader/index.js",
      "require": "./dist/loader/index.cjs.js"
    }
  },
  "workspaces": [
    "packages/react",
    "packages/angular"
  ],
  "bin": {
    "webquark-sandbox": "./scripts/webquark-serve.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Purely-IT/WebQuark.git"
  },
  "files": [
    "dist/",
    "scripts/webquark-serve.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/playground/playground.ts --outfile=src/playground/playground.bundled.js --loader .html:text --loader .css:text && bun build scripts/webquark-serve.ts --outfile=scripts/webquark-serve.js --target=node --format=cjs && stencil build",
    "start": "bun run scripts/start-playground.ts",
    "dev": "bun run start",
    "test": "stencil-test --prod",
    "test:watch": "stencil-test --prod --watch",
    "generate": "stencil generate",
    "release:prepare": "bun .github/scripts/publishing/prepare-release.ts",
    "release:verify": "bun .github/scripts/publishing/verify-packages.ts",
    "publish-all": "bun .github/scripts/publishing/publish-packages.ts",
    "align-headers": "bun run scripts/align-headers.ts"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "leaflet.gridlayer.googlemutant": "0.16.0"
  },
  "devDependencies": {
    "@stencil/angular-output-target": "^1.3.2",
    "@stencil/core": "^4.27.1 || ^5.0.0-0",
    "@stencil/react-output-target": "^1.5.3",
    "@stencil/vitest": "^1.8.3",
    "@types/google.maps": "^3.65.2",
    "@types/leaflet": "1.9.21",
    "@types/leaflet.gridlayer.googlemutant": "0.4.11",
    "@types/node": "^22.13.5",
    "@vitest/browser-playwright": "^4.0.0",
    "playwright": "^1.52.0",
    "vitest": "^4.0.0"
  },
  "license": "MIT"
}
