{
  "name": "Syntax Box",
  "tag": "q-syntax-box",
  "props": {
    "variant": {
      "type": "select",
      "options": [
        "panel",
        "plain"
      ],
      "default": "panel",
      "desc": "The layout variant of the syntax box container"
    },
    "language": {
      "type": "select",
      "options": [
        "html",
        "javascript",
        "css",
        "json",
        "typescript",
        "jsx",
        "tsx",
        "flow",
        "json5",
        "jsonc",
        "json-stringify",
        "postcss",
        "less",
        "scss",
        "angular",
        "vue",
        "lwc",
        "mjml",
        "handlebars",
        "graphql",
        "markdown",
        "mdx",
        "yaml"
      ],
      "default": "html",
      "desc": "Language used to format the editor content"
    },
    "height": {
      "type": "string",
      "default": "110px",
      "desc": "The height of the scrollable viewport (e.g. '110px' or 'auto' for fitting content)"
    },
    "copyable": {
      "type": "boolean",
      "default": true,
      "desc": "Renders a copy-to-clipboard button in the header"
    },
    "editable": {
      "type": "boolean",
      "default": false,
      "desc": "Enables interactive code editing inside the syntax box"
    },
    "heading": {
      "type": "string",
      "default": "CODE PREVIEW",
      "desc": "The header title displayed in the panel variant"
    },
    "code": {
      "type": "string",
      "desc": "The source code string to highlight (takes precedence over slot content)"
    },
    "required": {
      "type": "boolean",
      "default": false,
      "desc": "Marks the input as required in editable mode"
    },
    "disabled": {
      "type": "boolean",
      "default": false,
      "desc": "Disables interaction in editable mode"
    },
    "name": {
      "type": "string",
      "desc": "Field name included in form data",
      "default": "source"
    },
    "ariaLabel": {
      "type": "string",
      "desc": "Accessible name"
    },
    "value": {
      "type": "string",
      "desc": "Synchronized editable value"
    }
  },
  "slots": {
    "default": {
      "type": "html",
      "default": "&lt;div class=\"app-container\"&gt;\n  &lt;h1&gt;Hello World&lt;/h1&gt;\n  &lt;q-button variant=\"primary\"&gt;Click Me&lt;/q-button&gt;\n&lt;/div&gt;",
      "desc": "Projected content for this box, or direct q-syntax-view children for separate views"
    },
    "actions": {
      "type": "html",
      "desc": "Additional panel-header controls",
      "default": ""
    }
  },
  "variants": [
    {
      "name": "Panel Variant (HTML)",
      "props": {
        "variant": "panel",
        "heading": "HTML MARKUP",
        "copyable": true,
        "height": "110px",
        "code": "<div class=\"demo\">\n  <span>Interactive Item</span>\n</div>"
      }
    },
    {
      "name": "Two named views",
      "props": { "heading": "Button example" },
      "slots": {
        "default": "<q-syntax-view heading=\"Example HTML\" view-key=\"html\" code=\"&lt;q-button&gt;Save&lt;/q-button&gt;\" copyable></q-syntax-view><q-syntax-view heading=\"Notes\" view-key=\"notes\"><p>Use a short action label.</p></q-syntax-view>"
      }
    },
    {
      "name": "Plain Variant (HTML)",
      "props": {
        "variant": "plain",
        "height": "auto",
        "code": "<q-button size=\"sm\" disabled>Disabled Button</q-button>"
      }
    },
    {
      "name": "JavaScript Highlight",
      "props": {
        "variant": "plain",
        "language": "javascript",
        "height": "auto",
        "code": "const clickHandler = (event) => {\n  console.log('Clicked!', event.target);\n  return true;\n};"
      }
    },
    {
      "name": "CSS Highlight",
      "props": {
        "variant": "plain",
        "language": "css",
        "height": "auto",
        "code": ".demo-class {\n  display: flex;\n  color: var(--q-color-primary);\n  font-size: 1.2rem;\n}"
      }
    },
    {
      "name": "JSON Highlight",
      "props": {
        "variant": "plain",
        "language": "json",
        "height": "auto",
        "code": "{\n  \"name\": \"q-syntax-box\",\n  \"version\": \"1.0.0\",\n  \"private\": true\n}"
      }
    },
    {
      "name": "Editable Panel (JS)",
      "props": {
        "variant": "panel",
        "language": "javascript",
        "heading": "EDITABLE JS",
        "editable": true,
        "code": "const value = 'You can edit this!';\nconsole.log(value);",
        "height": "110px"
      }
    },
    {
      "name": "Editable Plain (HTML)",
      "props": {
        "variant": "plain",
        "language": "html",
        "editable": true,
        "code": "<div class=\"wrapper\">\n  <span>Edit me!</span>\n</div>",
        "height": "auto"
      }
    },
    {
      "name": "Empty Required Editor",
      "props": {
        "variant": "panel",
        "language": "html",
        "heading": "NEW TEMPLATE",
        "editable": true,
        "required": true,
        "code": "",
        "height": "110px"
      }
    },
    {
      "name": "Explicit Exact JSON Format",
      "props": {
        "variant": "panel",
        "language": "json",
        "editable": true,
        "heading": "EXACT JSON TOKENS",
        "code": "{\"10\":9007199254740993,\"2\":-0,\"same\":1,\"same\":2}",
        "height": "190px"
      }
    },
    {
      "name": "Slotted read-only content",
      "props": {
        "code": null,
        "value": null,
        "editable": false
      },
      "slots": {
        "default": "&lt;article&gt;Draft&lt;/article&gt;",
        "actions": "<q-link href=\"#reference\">Reference</q-link>"
      }
    },
    {
      "name": "Named form editor",
      "props": {
        "name": "source",
        "editable": true,
        "required": true,
        "value": "<section>Draft</section>",
        "ariaLabel": "HTML source"
      }
    }
  ],
  "edgeCases": [
    {
      "name": "Empty editor keeps its tab",
      "props": { "heading": "Draft sources" },
      "slots": {
        "default": "<q-syntax-view heading=\"Saved\" code=\"&lt;p&gt;Published&lt;/p&gt;\" copyable></q-syntax-view><q-syntax-view heading=\"Draft\" editable required name=\"draft\" aria-label=\"Draft HTML\"></q-syntax-view>"
      }
    },
    {
      "name": "Long Script Wrapping Test",
      "props": {
        "variant": "panel",
        "language": "javascript",
        "heading": "LONG SCRIPT",
        "height": "110px",
        "code": "function calculateFibonacciSequence(n) {\n  if (n <= 0) return [];\n  if (n === 1) return [0];\n  let sequence = [0, 1];\n  while (sequence.length < n) {\n    let nextValue = sequence[sequence.length - 1] + sequence[sequence.length - 2];\n    sequence.push(nextValue);\n  }\n  return sequence;\n}"
      }
    },
    {
      "name": "Literal Markup and Entities",
      "props": {
        "variant": "panel",
        "language": "html",
        "heading": "LITERAL SOURCE",
        "copyable": true,
        "code": "<b title=\"raw\">&lt; &amp; 雪</b>\n<!-- <q-button> -->",
        "height": "110px"
      }
    },
    {
      "name": "Preserve Spaces in a JavaScript Template",
      "props": {
        "variant": "panel",
        "language": "javascript",
        "editable": true,
        "heading": "LITERAL JAVASCRIPT",
        "code": "const message=`keep  spaces; { braces }`",
        "height": "110px"
      }
    },
    {
      "name": "Commented JSON Preserved",
      "props": {
        "variant": "panel",
        "language": "json",
        "editable": true,
        "heading": "COMMENTED JSON",
        "code": "{/* keep comment */\"value\":-0}",
        "height": "110px"
      }
    }
  ]
}
