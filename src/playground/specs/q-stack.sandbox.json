{
  "name": "Stack",
  "tag": "q-stack",
  "props": {
    "gap": {
      "type": "select",
      "default": "lg",
      "options": [
        "none",
        "xs",
        "sm",
        "md",
        "lg",
        "xl",
        "2xl",
        "3xl"
      ]
    },
    "align": {
      "type": "select",
      "default": "stretch",
      "options": [
        "stretch",
        "start",
        "center",
        "end"
      ]
    }
  },
  "slots": {
    "default": {
      "type": "html",
      "default": "<q-card>First card</q-card><q-card>Second card</q-card>",
      "desc": "Layout children"
    }
  },
  "variants": [
    {
      "name": "Default",
      "props": {}
    },
    {
      "name": "Generous spacing",
      "props": {
        "gap": "xl"
      }
    },
    {
      "name": "Centered unequal widths",
      "props": {
        "gap": "md",
        "align": "center"
      },
      "slots": {
        "default": "<q-chip>Draft</q-chip><q-chip>Ready for review</q-chip>"
      }
    }
  ],
  "edgeCases": [
    {
      "name": "Long content",
      "slots": {
        "default": "<q-card>Long content that can wrap as the available width decreases.</q-card><q-card>Another item</q-card>"
      }
    }
  ]
}
