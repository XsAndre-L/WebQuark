{
  "name": "Slider",
  "tag": "q-slider",
  "props": {
    "min": {
      "type": "number",
      "default": 0
    },
    "max": {
      "type": "number",
      "default": 100
    },
    "value": {
      "type": "number",
      "default": 25
    },
    "step": {
      "type": "number",
      "default": 1
    },
    "label": {
      "type": "text",
      "default": "Value"
    },
    "suffix": {
      "type": "text",
      "default": ""
    },
    "disabled": {
      "type": "boolean",
      "default": false
    },
    "showValue": {
      "type": "boolean",
      "desc": "Show the numeric value badge",
      "default": true
    },
    "name": {
      "type": "string",
      "desc": "Field name included in form data",
      "default": "volume"
    },
    "ariaLabel": {
      "type": "string",
      "desc": "Accessible name"
    }
  },
  "variants": [
    {
      "name": "Columns",
      "props": {
        "label": "Columns",
        "min": 1,
        "max": 10,
        "value": 3
      }
    },
    {
      "name": "Gap",
      "props": {
        "label": "Gap",
        "min": 4,
        "max": 40,
        "value": 16,
        "suffix": "px"
      }
    },
    {
      "name": "Fractional",
      "props": {
        "min": 0,
        "max": 1,
        "step": 0.1,
        "value": 0.5
      }
    },
    {
      "name": "Form field without value badge",
      "props": {
        "name": "volume",
        "ariaLabel": "Volume",
        "showValue": false,
        "suffix": "%",
        "value": 42
      }
    }
  ],
  "edgeCases": [
    {
      "name": "Omitted value starts at minimum",
      "props": {
        "min": 5,
        "value": null
      }
    },
    {
      "name": "Disabled slider",
      "props": {
        "disabled": true,
        "name": "volume"
      }
    }
  ]
}
