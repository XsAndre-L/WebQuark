{
  "name": "Progress",
  "tag": "q-progress",
  "props": {
    "variant": {
      "type": "select",
      "options": [
        "linear",
        "circular"
      ],
      "default": "linear",
      "desc": "Switches between the horizontal bar and circular ring"
    },
    "size": {
      "type": "string",
      "desc": "Size token sm, md, lg, or a positive pixel size",
      "default": "md"
    },
    "tone": {
      "type": "select",
      "options": [
        "neutral",
        "primary",
        "success",
        "warning",
        "danger"
      ],
      "default": "primary",
      "desc": "Applies a semantic fill colour"
    },
    "label": {
      "type": "string",
      "default": "",
      "desc": "Overrides the visible text in the circular variant"
    },
    "value": {
      "type": "number",
      "default": 35,
      "desc": "Completion percentage. Values outside 0–100 are clamped."
    },
    "indeterminate": {
      "type": "boolean",
      "default": false,
      "desc": "Shows progress without a known completion percentage"
    },
    "ariaLabel": {
      "type": "string",
      "desc": "Accessible name"
    },
    "ariaValueText": {
      "type": "string",
      "desc": "Spoken value, e.g. 2 of 5 files"
    }
  },
  "slots": {},
  "variants": [
    {
      "name": "Linear Progress",
      "props": {
        "variant": "linear",
        "value": 35
      }
    },
    {
      "name": "Circular Progress",
      "props": {
        "variant": "circular",
        "value": 35
      }
    },
    {
      "name": "Circular Custom Label",
      "props": {
        "variant": "circular",
        "value": 75,
        "label": "Running",
        "size": "lg"
      }
    },
    {
      "name": "Successful Linear Progress",
      "props": {
        "variant": "linear",
        "value": 100,
        "tone": "success"
      }
    },
    {
      "name": "Indeterminate Circular Progress",
      "props": {
        "variant": "circular",
        "indeterminate": true
      }
    },
    {
      "name": "Custom circular diameter",
      "props": {
        "variant": "circular",
        "size": 96,
        "value": 40,
        "ariaLabel": "Uploads",
        "ariaValueText": "2 of 5 files"
      }
    },
    {
      "name": "Custom linear height",
      "props": {
        "size": 10,
        "value": 80,
        "label": "Transfer"
      }
    },
    {
      "name": "Initial value",
      "props": {
        "value": 0,
        "label": "Queued"
      }
    }
  ],
  "edgeCases": [
    {
      "name": "Negative Value Clamp",
      "props": {
        "value": -40
      }
    },
    {
      "name": "Overflow Value Clamp",
      "props": {
        "value": 160
      }
    },
    {
      "name": "Long Circular Label",
      "props": {
        "variant": "circular",
        "value": 50,
        "label": "UPLOADING_SYSTEM_ASSETS_NOW"
      }
    }
  ]
}
