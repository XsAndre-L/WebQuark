{
  "name": "Inline",
  "tag": "q-inline",
  "props": {
    "gap": {
      "type": "select",
      "default": "sm",
      "options": [
        "none",
        "xs",
        "sm",
        "md",
        "lg",
        "xl",
        "2xl",
        "3xl"
      ]
    },
    "justify": {
      "type": "select",
      "default": "start",
      "options": [
        "start",
        "center",
        "end",
        "between"
      ]
    },
    "wrap": {
      "type": "boolean",
      "default": true
    },
    "align": {
      "type": "select",
      "default": "center",
      "desc": "Align items along the cross axis.",
      "options": [
        "center",
        "end",
        "start",
        "stretch"
      ]
    }
  },
  "slots": {
    "default": {
      "type": "html",
      "default": "<q-button>Save changes</q-button><q-button variant=\"ghost\">Cancel</q-button>",
      "desc": "Layout children"
    }
  },
  "variants": [
    {
      "name": "Default",
      "props": {}
    },
    {
      "name": "Generous spacing",
      "props": {
        "gap": "xl"
      }
    },
    {
      "name": "Align mixed-height actions",
      "props": {
        "align": "end",
        "justify": "between"
      },
      "slots": {
        "default": "<q-button size=\"sm\">Previous</q-button><q-button size=\"lg\">Continue</q-button><q-button size=\"md\">Save draft</q-button>"
      }
    },
    {
      "name": "Single line in a narrow host",
      "props": {
        "wrap": false,
        "style": "max-width:14rem"
      },
      "slots": {
        "default": "<q-button size=\"sm\">Previous</q-button><q-button size=\"lg\">Continue</q-button><q-button size=\"md\">Save draft</q-button>"
      }
    },
    {
      "name": "Wrapped actions in a narrow host",
      "props": {
        "wrap": true,
        "style": "max-width:14rem"
      },
      "slots": {
        "default": "<q-button size=\"sm\">Previous</q-button><q-button size=\"lg\">Continue</q-button><q-button size=\"md\">Save draft</q-button>"
      }
    }
  ],
  "edgeCases": [
    {
      "name": "Long content",
      "slots": {},
      "slot": "<q-card>Long content that can wrap as the available width decreases.</q-card><q-card>Another item</q-card>"
    }
  ]
}
