{
  "name": "Radio Group",
  "tag": "q-radio-group",
  "props": {
    "label": {
      "type": "string",
      "default": "Sign-in fields",
      "desc": "Visible group legend"
    },
    "value": {
      "type": "string",
      "default": "both",
      "desc": "Selected option value"
    },
    "size": {
      "type": "select",
      "default": "inherit",
      "options": [
        "inherit",
        "sm",
        "md",
        "lg"
      ],
      "desc": "Control size; inherit follows the nearest form or toolbar"
    },
    "orientation": {
      "type": "select",
      "options": [
        "horizontal",
        "responsive",
        "vertical"
      ],
      "default": "responsive",
      "desc": "Option arrangement"
    },
    "required": {
      "type": "boolean",
      "default": false,
      "desc": "Requires one selected value"
    },
    "disabled": {
      "type": "boolean",
      "default": false,
      "desc": "Locks all options"
    },
    "labelHidden": {
      "type": "boolean",
      "default": false,
      "desc": "Keep the label accessible without displaying it"
    },
    "reserveFeedback": {
      "type": "boolean",
      "desc": "Reserve one feedback line; omit to inherit"
    }
  },
  "slots": {},
  "options": [
    {
      "label": "Email",
      "value": "email"
    },
    {
      "label": "Username",
      "value": "username"
    },
    {
      "label": "Email and Username",
      "value": "both"
    }
  ],
  "variants": [
    {
      "name": "Responsive",
      "props": {
        "orientation": "responsive",
        "value": "both"
      }
    },
    {
      "name": "Vertical",
      "props": {
        "orientation": "vertical",
        "value": "email"
      }
    },
    {
      "name": "Disabled",
      "props": {
        "disabled": true,
        "value": "username"
      }
    }
  ]
}
