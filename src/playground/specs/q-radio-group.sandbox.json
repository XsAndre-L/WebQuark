{
  "name": "Radio Group",
  "tag": "q-radio-group",
  "props": {
    "label": {
      "type": "string",
      "default": "Sign-in fields",
      "desc": "Visible group legend"
    },
    "value": {
      "type": "string",
      "default": "both",
      "desc": "Selected option value"
    },
    "size": {
      "type": "select",
      "default": "inherit",
      "options": [
        "inherit",
        "sm",
        "md",
        "lg"
      ],
      "desc": "Control size; inherit follows the nearest form or toolbar"
    },
    "orientation": {
      "type": "select",
      "options": [
        "horizontal",
        "responsive",
        "vertical"
      ],
      "default": "responsive",
      "desc": "Option arrangement"
    },
    "required": {
      "type": "boolean",
      "default": false,
      "desc": "Requires one selected value"
    },
    "disabled": {
      "type": "boolean",
      "default": false,
      "desc": "Locks all options"
    },
    "labelHidden": {
      "type": "boolean",
      "default": false,
      "desc": "Keep the label accessible without displaying it"
    },
    "reserveFeedback": {
      "type": "boolean",
      "desc": "Reserve one feedback line; omit to inherit"
    },
    "options": {
      "type": "array",
      "desc": "String labels or objects with label, value, disabled and icon",
      "default": [
        {
          "label": "Email",
          "value": "email"
        },
        {
          "label": "Username",
          "value": "username"
        },
        {
          "label": "Email and Username",
          "value": "both"
        }
      ]
    },
    "description": {
      "type": "string",
      "desc": "Supporting instructions"
    },
    "error": {
      "type": "string",
      "desc": "Validation feedback"
    },
    "errorMessage": {
      "type": "string",
      "desc": "Deprecated fallback. Use error; omit the replacement to try this alias."
    },
    "name": {
      "type": "string",
      "desc": "Field name included in form data",
      "default": "signInField"
    },
    "ariaLabel": {
      "type": "string",
      "desc": "Accessible name"
    }
  },
  "slots": {},
  "variants": [
    {
      "name": "Responsive",
      "props": {
        "orientation": "responsive",
        "value": "both"
      }
    },
    {
      "name": "Vertical",
      "props": {
        "orientation": "vertical",
        "value": "email"
      }
    },
    {
      "name": "Disabled",
      "props": {
        "disabled": true,
        "value": "username"
      }
    },
    {
      "name": "Horizontal with individual disabled choice",
      "props": {
        "options": [
          "Home",
          {
            "label": "Archive",
            "value": "archive",
            "disabled": true
          },
          {
            "label": "Inbox",
            "value": "inbox",
            "icon": "mail"
          }
        ],
        "orientation": "horizontal",
        "value": "inbox",
        "name": "folder",
        "description": "Choose a destination."
      }
    }
  ],
  "edgeCases": [
    {
      "name": "Required empty field",
      "props": {
        "options": [
          {
            "label": "Email",
            "value": "email"
          },
          {
            "label": "Username",
            "value": "username"
          },
          {
            "label": "Email and Username",
            "value": "both"
          }
        ],
        "required": true,
        "value": "",
        "labelHidden": true,
        "ariaLabel": "Destination",
        "name": "destination"
      }
    },
    {
      "name": "Legacy validation text",
      "props": {
        "errorMessage": "Choose a destination",
        "error": null
      }
    }
  ]
}
