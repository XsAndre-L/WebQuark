{
  "name": "Sidepanel (Drawer)",
  "tag": "q-sidepanel",
  "props": {
    "open": { "type": "boolean", "default": false, "desc": "Drawer animation active state controller" },
    "side": { "type": "select", "options": ["left", "right", "top", "bottom"], "default": "right", "desc": "Screen edge slide positioning" },
    "panelSize": { "type": "string", "default": "320px", "desc": "Panel dimension (width or height depend on side)" }
  },
  "slots": {
    "default": {
      "type": "html",
      "default": "<div style=\"display: flex; flex-direction: column; gap: 16px;\">\n  <p style=\"margin:0;font-size:0.9rem;color:var(--text-muted)\">Configure and customize dashboard system profile attributes.</p>\n  <q-input label=\"Profile Alias\" placeholder=\"e.g. My Workspace Profile\"></q-input>\n  <q-button id=\"closePanelBtn\" variant=\"primary\">Save Configuration</q-button>\n</div>",
      "desc": "Inner drawer content block"
    },
    "header": { "type": "text", "default": "Drawer Settings Menu", "desc": "Title displayed inside sidepanel header" }
  },
  "variants": [
    { "name": "Right Side Panel (320px)", "props": { "open": false, "side": "right", "panelSize": "320px" } },
    { "name": "Left Side Panel (320px)", "props": { "open": false, "side": "left", "panelSize": "320px" } },
    { "name": "Top Drawer Sheet (200px)", "props": { "open": false, "side": "top", "panelSize": "200px" } },
    { "name": "Bottom Drawer Sheet (250px)", "props": { "open": false, "side": "bottom", "panelSize": "250px" } },
    { "name": "Wide Sheet (550px)", "props": { "open": false, "side": "right", "panelSize": "550px" } }
  ],
  "edgeCases": [
    { "name": "Without Header Slot content", "props": { "open": false }, "slots": { "header": "" } },
    {
      "name": "Overflow Long Content Scroll",
      "props": { "open": false },
      "slot": "<div style=\"height:1200px;background:linear-gradient(to bottom, var(--primary) 0%, var(--q-color-success) 100%);padding:20px;border-radius:8px;color:#fff;font-weight:bold\">\n  Scrollable Panel Height Content\n</div>"
    }
  ]
}
