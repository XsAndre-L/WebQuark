{
  "tag": "q-toast",
  "name": "Toast",
  "description": "Show a toast with a chosen title, description, duration and dismiss behavior. Use its returned ID to dismiss it or clear the queue.",
  "props": {
    "position": {
      "type": "select",
      "options": [
        "top-start",
        "top-center",
        "top-end",
        "bottom-start",
        "bottom-center",
        "bottom-end"
      ],
      "default": "top-end",
      "desc": "Fixed viewport position for the toast stack"
    },
    "maxVisible": {
      "type": "number",
      "min": 1,
      "default": 3,
      "desc": "Maximum number of visible toasts before queueing"
    }
  },
  "variants": [
    {
      "name": "Queue with one visible toast",
      "props": {
        "maxVisible": 1,
        "position": "bottom-center"
      }
    }
  ],
  "edgeCases": [
    {
      "name": "Persistent notifications",
      "props": {
        "position": "top-start"
      }
    }
  ]
}
