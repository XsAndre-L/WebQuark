{
  "name": "Map",
  "tag": "q-map",
  "props": {
    "provider": {
      "type": "select",
      "options": [
        "tiles",
        "vector",
        "google"
      ],
      "default": "tiles",
      "desc": "Map imagery provider"
    },
    "tileUrl": {
      "type": "string",
      "default": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
      "desc": "Leaflet tile URL template used by the tiles provider"
    },
    "rasterTileLoadingPolicy": {
      "type": "select",
      "options": [
        "full-batch",
        "progressive"
      ],
      "default": "full-batch",
      "desc": "Full-batch or first-success progressive raster replacement"
    },
    "googleApiKey": {
      "type": "string",
      "default": "",
      "desc": "Browser-restricted Maps JavaScript API key used by the Google provider",
      "sensitive": true
    },
    "googleMapType": {
      "type": "select",
      "options": [
        "roadmap",
        "satellite",
        "terrain",
        "hybrid"
      ],
      "default": "roadmap",
      "desc": "Google base-map style"
    },
    "attribution": {
      "type": "string",
      "default": "© OpenStreetMap contributors",
      "desc": "Visible tile-provider attribution label"
    },
    "attributionUrl": {
      "type": "string",
      "default": "https://www.openstreetmap.org/copyright",
      "desc": "Optional attribution link target"
    },
    "centerLatitude": {
      "type": "number",
      "default": -26.16,
      "desc": "Controlled viewport centre latitude"
    },
    "centerLongitude": {
      "type": "number",
      "default": 28.05,
      "desc": "Controlled viewport centre longitude"
    },
    "zoom": {
      "type": "number",
      "default": 11,
      "desc": "Controlled Leaflet zoom level"
    },
    "minZoom": {
      "type": "number",
      "default": 0,
      "desc": "Lowest permitted zoom level"
    },
    "maxZoom": {
      "type": "number",
      "default": 19,
      "desc": "Highest permitted zoom level"
    },
    "maxBounds": {
      "type": "object",
      "desc": "Bounds object with southLatitude, westLongitude, northLatitude and eastLongitude"
    },
    "maxBoundsViscosity": {
      "type": "number",
      "default": 1,
      "desc": "Boundary resistance from 0 (soft) to 1 (hard)"
    },
    "markers": {
      "type": "array",
      "desc": "Array of typed marker definitions",
      "default": [
        {
          "id": "rosebank",
          "latitude": -26.1459,
          "longitude": 28.0416,
          "label": "Rosebank store, active",
          "variant": "success"
        },
        {
          "id": "sandton",
          "latitude": -26.1076,
          "longitude": 28.0567,
          "label": "Sandton store, attention required",
          "variant": "warning"
        },
        {
          "id": "central",
          "latitude": -26.2041,
          "longitude": 28.0473,
          "label": "Johannesburg central, inactive",
          "variant": "muted"
        }
      ]
    },
    "clusterMarkers": {
      "type": "boolean",
      "default": false,
      "desc": "Group nearby markers into interactive clusters"
    },
    "clusterRadius": {
      "type": "number",
      "default": 48,
      "desc": "Cluster radius in screen pixels"
    },
    "clusterMinPoints": {
      "type": "number",
      "default": 2,
      "desc": "Minimum nearby markers required to form a cluster"
    },
    "clusterMaxZoom": {
      "type": "number",
      "desc": "Last zoom level where clusters may remain"
    },
    "selectedMarkerId": {
      "type": "string-or-number",
      "desc": "Marker ID as a JSON string or number"
    },
    "ariaLabel": {
      "type": "string",
      "default": "Interactive map",
      "desc": "Accessible map-region name"
    },
    "zoomControls": {
      "type": "boolean",
      "desc": "Show zoom controls",
      "default": true
    },
    "scrollWheelZoom": {
      "type": "boolean",
      "desc": "Zoom when scrolling over the map",
      "default": true
    },
    "tilePreloadBuffer": {
      "type": "number",
      "desc": "Extra raster tile rows and columns",
      "default": 0,
      "min": 0,
      "max": 4
    },
    "vectorPadding": {
      "type": "number",
      "desc": "Relative vector viewport padding",
      "default": 0.2,
      "min": 0,
      "max": 0.5,
      "step": 0.1
    },
    "vectorStyleUrl": {
      "type": "string",
      "desc": "MapLibre style URL for the vector provider",
      "default": ""
    }
  },
  "slots": {
    "empty": {
      "type": "html",
      "default": "<strong>Map unavailable</strong><span style=\"display:block;margin-top:4px\">Configure a tile provider to display locations.</span>",
      "desc": "Missing-configuration content shown when the requested provider lacks its URL or key"
    },
    "error": {
      "type": "html",
      "default": "<strong>Map imagery unavailable</strong><span style=\"display:block;margin-top:4px\">Try again or choose another provider.</span>",
      "desc": "Failure content shown when no requested or fallback provider can be activated"
    }
  },
