{
  "name": "Icon",
  "tag": "q-icon",
  "props": {
    "size": {
      "type": "string",
      "default": "md",
      "desc": "Preset sm/md/lg, pixel size, or CSS length."
    },
    "color": {
      "type": "string",
      "default": "currentColor",
      "desc": "CSS color override"
    },
    "name": {
      "type": "string",
      "default": "check",
      "desc": "The name of the icon (e.g. settings, heart, or logo.png)"
    },
    "library": {
      "type": "string",
      "default": "local",
      "desc": "Lucide, font-awesome/fontawesome, local, or a custom library URL/base path."
    },
    "localPath": {
      "type": "string",
      "default": "./assets/icons/",
      "desc": "Custom local assets base path"
    },
    "definition": {
      "type": "object",
      "desc": "Trusted compile-time icon data. Takes precedence over `name` and never performs I/O."
    },
    "fetchTimeout": {
      "type": "number",
      "default": 8000,
      "desc": "SVG fetch timeout in milliseconds."
    },
    "label": {
      "type": "string",
      "desc": "Meaningful icons require a label; unlabeled icons are hidden from assistive technology."
    },
    "lib": {
      "type": "string",
      "desc": "Deprecated fallback for library. Effective default lucide."
    },
    "libVersion": {
      "type": "string",
      "desc": "Deprecated fallback for libraryVersion."
    },
    "libraryVersion": {
      "type": "string",
      "desc": "Overrides the version of built-in remote libraries."
    }
  },
  "slots": {},
  "variants": [
    {
      "name": "Lucide Settings (Small)",
      "props": {
        "library": "lucide",
        "name": "settings",
        "size": "sm",
        "color": "var(--q-color-primary)"
      }
    },
    {
      "name": "Lucide Settings (Medium)",
      "props": {
        "library": "lucide",
        "name": "settings",
        "size": "md",
        "color": "var(--q-color-primary)"
      }
    },
    {
      "name": "Lucide Settings (Large)",
      "props": {
        "library": "lucide",
        "name": "settings",
        "size": "lg",
        "color": "var(--q-color-primary)"
      }
    },
    {
      "name": "Lucide Heart (Large Red)",
      "props": {
        "library": "lucide",
        "name": "heart",
        "size": "48",
        "color": "var(--q-color-danger)"
      }
    },
    {
      "name": "FontAwesome Heart",
      "props": {
        "library": "font-awesome",
        "name": "heart",
        "size": "24",
        "color": "var(--q-color-success)"
      }
    },
    {
      "name": "FontAwesome Star (Gold)",
      "props": {
        "library": "font-awesome",
        "name": "star",
        "size": "32",
        "color": "var(--q-color-warning)"
      }
    },
    {
      "name": "Local Asset SVG (Standard)",
      "props": {
        "library": "local",
        "name": "check",
        "size": "24",
        "color": "var(--q-color-success)"
      }
    },
    {
      "name": "Local SVG with Query and Inferred Extension",
      "props": {
        "library": "local",
        "name": "check?v=1.2#preview",
        "size": "24"
      }
    },
    {
      "name": "Labeled local icon",
      "props": {
        "library": "local",
        "name": "check",
        "label": "Saved",
        "size": "1.5rem"
      }
    },
    {
      "name": "Inline check definition",
      "props": {
        "label": "Complete",
        "definition": {
          "name": "complete",
          "node": [
            [
              "path",
              {
                "d": "m4 12 5 5L20 6",
                "stroke": "currentColor",
                "stroke-width": "2",
                "fill": "none"
              }
            ]
          ]
        }
      }
    }
  ],
  "edgeCases": [
    {
      "name": "Missing Icon Fallback",
      "props": {
        "library": "lucide",
        "name": "non-existent-icon-name-xyz"
      }
    },
    {
      "name": "Binary Image File (.png)",
      "props": {
        "library": "local",
        "name": "check-preview.png",
        "size": "64"
      }
    },
    {
      "name": "Extremely Large Custom Size",
      "props": {
        "library": "lucide",
        "name": "bell",
        "size": "120",
        "color": "var(--q-color-secondary)"
      }
    },
    {
      "name": "Binary Image with Query and Fragment",
      "props": {
        "library": "local",
        "name": "check-preview.png?v=2#preview",
        "size": "64"
      }
    }
  ]
}
