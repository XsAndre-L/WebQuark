{
  "name": "Quantity Selector",
  "tag": "q-quantity-selector",
  "props": {
    "orientation": {
      "type": "select",
      "options": [
        "horizontal",
        "vertical"
      ],
      "desc": "Layout alignment variant"
    },
    "min": {
      "type": "number",
      "desc": "Minimum allowed value limit"
    },
    "max": {
      "type": "number",
      "desc": "Maximum allowed value limit"
    },
    "step": {
      "type": "number",
      "default": 1,
      "desc": "The increment/decrement step amount"
    },
    "value": {
      "type": "number",
      "default": 0,
      "desc": "The current quantity value"
    },
    "size": {
      "type": "select",
      "default": "inherit",
      "options": [
        "inherit",
        "sm",
        "md",
        "lg"
      ],
      "desc": "Control size; inherit follows the nearest form or toolbar"
    },
    "variant": {
      "type": "select",
      "desc": "Deprecated fallback. Use orientation; omit the replacement to try this alias.",
      "options": [
        "horizontal",
        "vertical"
      ]
    }
  },
  "variants": [
    {
      "name": "Standard Horizontal",
      "props": {
        "value": 5
      }
    },
    {
      "name": "Vertical Stack",
      "props": {
        "orientation": "vertical",
        "value": 10
      }
    },
    {
      "name": "Stepping by 5",
      "props": {
        "value": 25,
        "step": 5
      }
    },
    {
      "name": "Bounded (1 to 10)",
      "props": {
        "value": 5,
        "min": 1,
        "max": 10
      }
    },
    {
      "name": "Negative Bounds (-50 to 50)",
      "props": {
        "value": 0,
        "min": -50,
        "max": 50
      }
    },
    {
      "name": "Legacy vertical orientation",
      "props": {
        "orientation": null,
        "variant": "vertical"
      }
    }
  ],
  "edgeCases": [
    {
      "name": "No limits (unbounded)",
      "props": {
        "value": 1000,
        "min": null,
        "max": null
      }
    },
    {
      "name": "Locked to Min",
      "props": {
        "value": 1,
        "min": 1,
        "max": 10
      }
    },
    {
      "name": "Locked to Max",
      "props": {
        "value": 10,
        "min": 1,
        "max": 10
      }
    }
  ]
}
