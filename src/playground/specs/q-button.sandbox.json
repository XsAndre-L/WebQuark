{
  "name": "Button",
  "tag": "q-button",
  "props": {
    "variant": {
      "type": "select",
      "options": [
        "primary",
        "secondary",
        "success",
        "danger",
        "ghost",
        "text"
      ],
      "default": "primary",
      "desc": "Shorthand button background styling variant"
    },
    "size": {
      "type": "select",
      "default": "inherit",
      "options": [
        "inherit",
        "sm",
        "md",
        "lg"
      ],
      "desc": "Control size; inherit follows the nearest form or toolbar"
    },
    "icon": {
      "type": "string",
      "default": "",
      "desc": "Leading Lucide icon shorthand; icon-left slot content overrides it"
    },
    "ariaLabel": {
      "type": "string",
      "default": "",
      "desc": "Accessible name required when the button has no visible text"
    },
    "expand": {
      "type": "boolean",
      "default": false,
      "desc": "Width layout block stretch (100% parent container width)"
    },
    "href": {
      "type": "string",
      "default": "",
      "desc": "Turns the button element into a standard anchor link tag"
    },
    "target": {
      "type": "string",
      "desc": "Browsing context name or _self, _blank, _parent, _top."
    },
    "disabled": {
      "type": "boolean",
      "default": false,
      "desc": "Locks click events and styles disabled state"
    },
    "loading": {
      "type": "boolean",
      "default": false,
      "desc": "Swaps label with spinner icon while blocking events"
    },
    "download": {
      "type": "string",
      "desc": "Enables native download behavior when the component operates as a link."
    },
    "form": {
      "type": "string",
      "desc": "Explicit native form ID in this tree; unresolved IDs do not fall back."
    },
    "formAction": {
      "type": "string",
      "desc": "Overrides the owning form's action for this submission."
    },
    "formEnctype": {
      "type": "select",
      "desc": "Overrides the owning form's encoding for this submission.",
      "options": [
        "application/x-www-form-urlencoded",
        "multipart/form-data",
        "text/plain"
      ]
    },
    "formMethod": {
      "type": "select",
      "desc": "Overrides the owning form's method for this submission.",
      "options": [
        "dialog",
        "get",
        "post"
      ]
    },
    "formNoValidate": {
      "type": "boolean",
      "default": false,
      "desc": "Skips validation for this submitter while retaining cancellation and collection."
    },
    "formTarget": {
      "type": "string",
      "desc": "Overrides the owning form's browsing context for this submission."
    },
    "iconOnly": {
      "type": "boolean",
      "desc": "Auto-detected from slotted icon content when omitted."
    },
    "layout": {
      "type": "select",
      "default": "inline",
      "desc": "Arrange the icon and label horizontally or in a stack.",
      "options": [
        "inline",
        "stacked"
      ]
    },
    "name": {
      "type": "string",
      "desc": "Successful submission name when this button is the submitter."
    },
    "rel": {
      "type": "string",
      "desc": "Defaults to `noopener noreferrer` when `target=\"_blank\"`."
    },
    "shape": {
      "type": "select",
      "default": "default",
      "desc": "The `circle` shape uses a fixed-size circular presentation.",
      "options": [
        "circle",
        "default",
        "pill"
      ]
    },
    "type": {
      "type": "select",
      "default": "button",
      "desc": "Applied to the native `<button>` when `href` is unset.",
      "options": [
        "button",
        "reset",
        "submit"
      ]
    },
    "value": {
      "type": "string",
      "default": "",
      "desc": "Successful submission value when this button is the submitter."
    }
  },
  "slots": {
    "default": {
      "type": "html",
      "default": "Click Me",
      "desc": "Default Slot label content text"
    },
    "icon-left": {
      "type": "html",
      "default": "",
      "desc": "Appends inline element/icon to the left side"
    },
    "icon-right": {
      "type": "html",
      "default": "",
      "desc": "Appends inline element/icon to the right side"
    }
  },
  "variants": [
    {
      "name": "Primary MD",
      "props": {
        "variant": "primary",
        "size": "md"
      },
      "slots": {
        "default": "Primary Button"
      }
    },
    {
      "name": "Secondary MD",
      "props": {
        "variant": "secondary",
        "size": "md"
      },
      "slots": {
        "default": "Secondary Button"
      }
    },
    {
      "name": "Success LG",
      "props": {
        "variant": "success",
        "size": "lg"
      },
      "slots": {
        "default": "Success Action"
      }
    },
    {
      "name": "Danger SM",
      "props": {
        "variant": "danger",
        "size": "sm"
      },
      "slots": {
        "default": "Danger Trigger"
      }
    },
    {
      "name": "Ghost Styling",
      "props": {
        "variant": "ghost"
      },
      "slots": {
        "default": "Ghost Button"
      }
    },
    {
      "name": "Text Only link style",
      "props": {
        "variant": "text"
      },
      "slots": {
        "default": "Text Button"
      }
    },
    {
      "name": "Disabled State",
      "props": {
        "variant": "primary",
        "disabled": true
      },
      "slots": {
        "default": "Disabled Button"
      }
    },
    {
      "name": "Loading State spinner",
      "props": {
        "variant": "primary",
        "loading": true
      },
      "slots": {
        "default": "Loading Button"
      }
    },
    {
      "name": "Expanded full width",
      "props": {
        "variant": "primary",
        "expand": true
      },
      "slots": {
        "default": "Expanded Block Button"
      }
    },
    {
      "name": "Stacked label and icon",
      "props": {
        "layout": "stacked",
        "icon": "copy"
      },
      "slots": {
        "default": "Copy"
      }
    },
    {
      "name": "Download a local illustration",
      "props": {
        "href": "assets/comparison-before.svg",
        "download": "workspace.svg",
        "variant": "text"
      },
      "slots": {
        "default": "Download workspace"
      }
    }
  ],
  "edgeCases": [
    {
      "name": "Super Long Text Wrapping",
      "props": {
        "variant": "primary"
      },
      "slots": {
        "default": "This is a button containing a ridiculously long text content that will test wrapping dynamics and grid boundaries"
      }
    },
    {
      "name": "Formatted label",
      "props": {
        "variant": "secondary"
      },
      "slots": {
        "default": "<strong>Save</strong> draft"
      }
    },
    {
      "name": "Icon-only Button",
      "props": {
        "variant": "primary",
        "icon": "flame",
        "ariaLabel": "Ignite",
        "shape": "circle",
        "iconOnly": true
      },
      "slots": {
        "default": ""
      }
    }
  ]
}
