{
  "name": "Button",
  "tag": "q-button",
  "props": {
    "variant": {
      "type": "select",
      "options": [
        "primary",
        "secondary",
        "success",
        "danger",
        "ghost",
        "text"
      ],
      "default": "primary",
      "desc": "Shorthand button background styling variant"
    },
    "size": {
      "type": "select",
      "default": "inherit",
      "options": [
        "inherit",
        "sm",
        "md",
        "lg"
      ],
      "desc": "Control size; inherit follows the nearest form or toolbar"
    },
    "icon": {
      "type": "string",
      "default": "",
      "desc": "Leading Lucide icon shorthand; icon-left slot content overrides it"
    },
    "ariaLabel": {
      "type": "string",
      "default": "",
      "desc": "Accessible name required when the button has no visible text"
    },
    "expand": {
      "type": "boolean",
      "default": false,
      "desc": "Width layout block stretch (100% parent container width)"
    },
    "href": {
      "type": "string",
      "default": "",
      "desc": "Turns the button element into a standard anchor link tag"
    },
    "target": {
      "type": "select",
      "options": [
        "",
        "_blank",
        "_self",
        "_parent",
        "_top"
      ],
      "default": "",
      "desc": "Target link viewport target context (when href is set)"
    },
    "disabled": {
      "type": "boolean",
      "default": false,
      "desc": "Locks click events and styles disabled state"
    },
    "loading": {
      "type": "boolean",
      "default": false,
      "desc": "Swaps label with spinner icon while blocking events"
    }
  },
  "slots": {
    "default": {
      "type": "text",
      "default": "Click Me",
      "desc": "Default Slot label content text"
    },
    "icon-left": {
      "type": "html",
      "default": "",
      "desc": "Appends inline element/icon to the left side"
    },
    "icon-right": {
      "type": "html",
      "default": "",
      "desc": "Appends inline element/icon to the right side"
    }
  },
  "variants": [
    {
      "name": "Primary MD",
      "props": {
        "variant": "primary",
        "size": "md"
      },
      "slots": {
        "default": "Primary Button"
      }
    },
    {
      "name": "Secondary MD",
      "props": {
        "variant": "secondary",
        "size": "md"
      },
      "slots": {
        "default": "Secondary Button"
      }
    },
    {
      "name": "Success LG",
      "props": {
        "variant": "success",
        "size": "lg"
      },
      "slots": {
        "default": "Success Action"
      }
    },
    {
      "name": "Danger SM",
      "props": {
        "variant": "danger",
        "size": "sm"
      },
      "slots": {
        "default": "Danger Trigger"
      }
    },
    {
      "name": "Ghost Styling",
      "props": {
        "variant": "ghost"
      },
      "slots": {
        "default": "Ghost Button"
      }
    },
    {
      "name": "Text Only link style",
      "props": {
        "variant": "text"
      },
      "slots": {
        "default": "Text Button"
      }
    },
    {
      "name": "Disabled State",
      "props": {
        "variant": "primary",
        "disabled": true
      },
      "slots": {
        "default": "Disabled Button"
      }
    },
    {
      "name": "Loading State spinner",
      "props": {
        "variant": "primary",
        "loading": true
      },
      "slots": {
        "default": "Loading Button"
      }
    },
    {
      "name": "Expanded full width",
      "props": {
        "variant": "primary",
        "expand": true
      },
      "slots": {
        "default": "Expanded Block Button"
      }
    }
  ],
  "edgeCases": [
    {
      "name": "Super Long Text Wrapping",
      "props": {
        "variant": "primary"
      },
      "slots": {
        "default": "This is a button containing a ridiculously long text content that will test wrapping dynamics and grid boundaries"
      }
    },
    {
      "name": "HTML Injection Safe Verification",
      "props": {
        "variant": "primary"
      },
      "slots": {
        "default": "<b>Formatted HTML</b> <script>console.log(\"XSS block test\")</script>"
      }
    },
    {
      "name": "Icon-only Button",
      "props": {
        "variant": "primary",
        "icon": "flame",
        "ariaLabel": "Ignite"
      },
      "slots": {
        "default": ""
      }
    }
  ]
}
