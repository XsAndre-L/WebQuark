{
  "name": "Dropdown",
  "tag": "q-dropdown",
  "props": {
    "width": {
      "type": "select",
      "default": "",
      "options": ["", "xs", "sm", "md", "lg", "xl", "xxl", "full", "fit-options"],
      "desc": "Horizontal width independent of size; empty preserves existing layout"
    },
    "size": {
      "type": "select",
      "default": "inherit",
      "options": [
        "inherit",
        "sm",
        "md",
        "lg"
      ],
      "desc": "Control size; inherit follows the nearest form or toolbar"
    },
    "searchable": {
      "type": "boolean",
      "default": false,
      "desc": "Enables local or external option search"
    },
    "searchMode": { "type": "select", "default": "default", "options": ["default", "menu"], "desc": "Type in the main control, or use a separate search inside the menu" },
    "label": {
      "type": "string",
      "default": "Environment Server",
      "desc": "Floating form label caption"
    },
    "ariaLabel": {
      "type": "string",
      "default": "",
      "desc": "Accessible name for the trigger and option list"
    },
    "placeholder": {
      "type": "string",
      "default": "Select an option...",
      "desc": "Text displayed when value is empty"
    },
    "value": {
      "type": "string",
      "default": "",
      "desc": "Active selected options key"
    },
    "disabled": {
      "type": "boolean",
      "default": false,
      "desc": "Locks dropdown menu and styles disabled look"
    },
    "labelHidden": {
      "type": "boolean",
      "default": false,
      "desc": "Keep the label accessible without displaying it"
    },
    "reserveFeedback": {
      "type": "boolean",
      "desc": "Reserve one feedback line; omit to inherit"
    },
    "collisionPadding": {
      "type": "number",
      "default": 8,
      "desc": "Minimum distance maintained between the open menu and viewport edges."
    },
    "description": {
      "type": "string",
      "desc": "Supporting text, replaced by an active error."
    },
    "error": {
      "type": "string",
      "desc": "Custom validation error; independent of currently loaded options."
    },
    "externalSearch": {
      "type": "boolean",
      "default": false,
      "desc": "Delegates filtering and pagination to the consumer."
    },
    "hasMore": {
      "type": "boolean",
      "default": false,
      "desc": "Indicates another externally loaded option page is available."
    },
    "loading": {
      "type": "boolean",
      "default": false,
      "desc": "Show the loading state."
    },
    "multiple": {
      "type": "boolean",
      "default": false,
      "desc": "Select several options. Uses values/qValuesChange instead of value/qChange."
    },
    "name": {
      "type": "string",
      "desc": "Name included in form values."
    },
    "options": {
      "type": "array",
      "default": [
        {
          "label": "Production Server Host",
          "value": "prod"
        },
        {
          "label": "Staging Sandbox Gateway",
          "value": "staging"
        },
        {
          "label": "Local Development Server",
          "value": "dev"
        },
        {
          "label": "Disaster Recovery Vault",
          "value": "dr"
        }
      ],
      "desc": "Options as a structured array of label/value pairs."
    },
    "placement": {
      "type": "select",
      "default": "auto",
      "desc": "Choose top or bottom, or let the component use the available viewport space.",
      "options": [
        "auto",
        "bottom",
        "top"
      ]
    },
    "required": {
      "type": "boolean",
      "default": false,
      "desc": "Require a selection for form validation."
    },
    "values": {
      "type": "array",
      "default": [],
      "desc": "Selected identities in multiple mode. Replace the array to update selections."
    }
  },
  "slots": { "icon-left": {"type":"html", "default":"", "desc":"Leading trigger content."} },
  "variants": [
    {
      "name": "Standard Dropdown",
      "props": {
        "label": "Server Instance",
        "value": "staging",
        "size": "md"
      }
    },
    {
      "name": "Search in main control (default)",
      "props": {
        "label": "Searchable Options",
        "searchable": true,
        "value": "staging"
      }
    },
    { "name": "Search inside menu", "props": { "label": "Menu Search", "searchable": true, "searchMode": "menu", "value": "staging" } },
    {
      "name": "Small Dropdown",
      "props": {
        "label": "Small Server",
        "size": "sm",
        "value": "staging"
      }
    },
    {
      "name": "Large Dropdown",
      "props": {
        "label": "Large Server",
        "size": "lg",
        "value": "staging"
      }
    },
    {
      "name": "Without Title Label",
      "props": {
        "label": "Server profile",
        "labelHidden": true
      }
    },
    {
      "name": "Disabled Selection state",
      "props": {
        "label": "Immutable Setting",
        "disabled": true,
        "value": "prod"
      }
    },
    {
      "name": "Multiple environments",
      "props": {
        "multiple": true,
        "values": [
          "prod",
          "staging"
        ]
      }
    },
    {
      "name": "External search and pagination",
      "props": {
        "searchable": true,
        "externalSearch": true,
        "hasMore": true,
        "options": [
          {
            "value": "project-1",
            "label": "Project 1"
          },
          {
            "value": "project-2",
            "label": "Project 2"
          },
          {
            "value": "project-3",
            "label": "Project 3"
          },
          {
            "value": "project-4",
            "label": "Project 4"
          },
          {
            "value": "project-5",
            "label": "Project 5"
          },
          {
            "value": "project-6",
            "label": "Project 6"
          },
          {
            "value": "project-7",
            "label": "Project 7"
          },
          {
            "value": "project-8",
            "label": "Project 8"
          },
          {
            "value": "project-9",
            "label": "Project 9"
          },
          {
            "value": "project-10",
            "label": "Project 10"
          }
        ],
        "label": "Projects"
      }
    },
    {
      "name": "Open above the trigger",
      "props": {
        "placement": "top",
        "collisionPadding": 16
      },
      "slots": {
        "icon-left": "↑"
      }
    }
  ],
  "edgeCases": [
    {
      "name": "Super Long Title label test",
      "props": {
        "label": "This is a super long label caption designed to test form field text overflow boundaries"
      }
    },
    {
      "name": "Required empty selection",
      "props": {
        "required": true,
        "name": "environment",
        "value": "",
        "description": "Choose a deployment environment."
      }
    },
    {
      "name": "Loading options",
      "props": {
        "loading": true,
        "options": []
      }
    },
    {
      "name": "No matching options",
      "props": {
        "options": [],
        "value": ""
      }
    }
  ]
}
