{
  "name": "Grid",
  "tag": "q-grid",
  "props": {
    "columns": {
      "type": "number",
      "default": 2,
      "min": 1,
      "max": 4,
      "desc": "One to four columns, with full-row children marked data-q-span=\"full\"."
    },
    "minItemWidth": {
      "type": "string",
      "default": "16rem"
    },
    "gap": {
      "type": "select",
      "default": "lg",
      "options": [
        "none",
        "xs",
        "sm",
        "md",
        "lg",
        "xl",
        "2xl",
        "3xl"
      ]
    },
    "columnGap": {
      "type": "select",
      "desc": "Horizontal spacing between columns. Omit to use gap.",
      "options": [
        "2xl",
        "3xl",
        "lg",
        "md",
        "none",
        "sm",
        "xl",
        "xs"
      ]
    },
    "rowGap": {
      "type": "select",
      "desc": "Vertical spacing between rows. Omit to use gap.",
      "options": [
        "2xl",
        "3xl",
        "lg",
        "md",
        "none",
        "sm",
        "xl",
        "xs"
      ]
    }
  },
  "slots": {
    "default": {
      "type": "html",
      "default": "<q-input label=\"First name\"></q-input><q-input label=\"Last name\"></q-input><q-textarea data-q-span=\"full\" label=\"Notes\" description=\"A full-row field\"></q-textarea>",
      "desc": "Layout children"
    }
  },
  "variants": [
    {
      "name": "Default",
      "props": {}
    },
    {
      "name": "Generous spacing",
      "props": {
        "gap": "xl"
      }
    },
    {
      "name": "Separate row and column spacing",
      "props": {
        "rowGap": "xl",
        "columnGap": "xs"
      }
    }
  ],
  "edgeCases": [
    {
      "name": "Long content",
      "slots": {},
      "slot": "<q-card>Long content that can wrap as the available width decreases.</q-card><q-card>Another item</q-card>"
    }
  ]
}
