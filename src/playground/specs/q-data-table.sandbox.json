{
  "name": "Data Table",
  "tag": "q-data-table",
  "props": {
    "rowGutter": {
      "type": "select",
      "options": ["none", "blank", "numbers", "custom"],
      "default": "blank",
      "desc": "Structural leading cell; custom uses stable row-specific slots"
    },
    "rowNumberOffset": {
      "type": "number",
      "default": 0,
      "desc": "Nonnegative safe integer offset for displayed row numbers"
    },
    "selectable": {
      "type": "boolean",
      "default": false,
      "desc": "Enables row checkboxes and master selection header toggle"
    },
    "showToolbar": {
      "type": "boolean",
      "default": false,
      "desc": "Enables top toolbar layout with search, filters, and actions"
    },
    "showSearch": {
      "type": "boolean",
      "default": false,
      "desc": "Enables search text input in the toolbar"
    },
    "keyField": {
      "type": "string",
      "default": "id",
      "desc": "Unique field key representing each row identity"
    },
    "rowClickable": {
      "type": "boolean",
      "default": true,
      "desc": "Enables full-row click and keyboard activation"
    },
    "sortable": {
      "type": "boolean",
      "default": false,
      "desc": "Enables sortable headers for columns that do not opt out"
    },
    "sortMode": {
      "type": "select",
      "options": ["table", "external"],
      "default": "table",
      "desc": "Use table to sort provided items locally, or external to only emit sort changes"
    },
    "sortColumn": {
      "type": "string",
      "default": "",
      "desc": "Currently sorted column key"
    },
    "sortDirection": {
      "type": "select",
      "options": ["", "asc", "desc"],
      "default": "",
      "desc": "Current sort direction"
    },
    "toolbarTitle": {
      "type": "string",
      "default": "",
      "desc": "Title text displayed in the top-left section of the toolbar"
    },
    "searchPlaceholder": {
      "type": "string",
      "default": "Search...",
      "desc": "Placeholder text for the search input"
    },
    "columns": {
      "type": "array",
      "default": [
        {
          "key": "id",
          "header": "ID",
          "width": "60px"
        },
        {
          "key": "name",
          "header": "Name",
          "width": "35%"
        },
        {
          "key": "role",
          "header": "Role"
        },
        {
          "key": "status",
          "header": "Status"
        }
      ],
      "desc": "JSON array of table column definitions"
    },
    "items": {
      "type": "array",
      "default": [
        {
          "id": "1",
          "name": "Administrator Account",
          "role": "Admin",
          "status": "Active"
        },
        {
          "id": "2",
          "name": "Content Editor Manager",
          "role": "Editor",
          "status": "Inactive"
        },
        {
          "id": "3",
          "name": "Viewer Guest",
          "role": "Viewer",
          "status": "Active"
        }
      ],
      "desc": "JSON array of data row items"
    },
    "rowActions": {
      "type": "array",
      "default": [],
      "desc": "JSON array of row action definitions with key, icon, and tooltip"
    },
    "searchValue": {
      "type": "string",
      "default": "",
      "desc": "Current search input value"
    },
    "ariaLabel": {
      "type": "string",
      "desc": "Accessible name for the grid; falls back to `toolbarTitle`, then \"Data table\".",
      "default": "Workspace members"
    },
    "loading": {
      "type": "boolean",
      "default": false,
      "desc": "Shows a loading state and suppresses row rendering while true."
    },
    "rowGroup": {
      "type": "callback",
      "desc": "Choose the role grouping callback or leave ungrouped.",
      "options": [
        "role"
      ]
    },
    "selectedKeys": {
      "type": "array",
      "default": [],
      "desc": "Stable keys of preselected rows. Assign an array as a property."
    },
    "twoLineRows": {
      "type": "boolean",
      "default": false,
      "desc": "Reserves two text lines per data cell; rich cells must fit the same content height."
    }
  },
  "slots": {
    "empty": {
      "type": "text",
      "default": "No items found in this section.",
      "desc": "Custom component fallback layout when rows are empty"
    },
    "footer": {
      "type": "html",
      "default": "",
      "desc": "Custom footer content slot (appends to table bottom)"
    },
    "toolbar-left": {
      "type": "html",
      "default": "",
      "desc": "Slot for elements rendered on the left of the toolbar (e.g. badges, counters)"
    },
    "filters": {
      "type": "html",
      "default": "",
      "desc": "Slot for filter elements (e.g. QDropdowns) rendered in the toolbar"
    },
    "actions": {
      "type": "html",
      "default": "",
      "desc": "Slot for action elements (e.g. buttons) rendered on the right of the toolbar"
    },
    "q-data-table-row-gutter-string%3A1": {
      "type": "html",
      "default": "",
      "desc": "Custom gutter for string row key 1, from getDataTableRowGutterSlotName(\"1\")."
    },
    "q-data-table-cell-string%3Astatus-string%3A1": {
      "type": "html",
      "default": "",
      "desc": "Status cell for string row key 1, from getDataTableCellSlotName(\"status\", \"1\")."
    }
  },
  "variants": [
    {
      "name": "Numbered Rows",
      "props": {
        "rowGutter": "numbers",
        "rowNumberOffset": 0
      }
    },
    {
      "name": "No Row Gutter",
      "props": {
        "rowGutter": "none"
      }
    },
    {
      "name": "Standard Data Grid",
      "props": {
        "selectable": false
      }
    },
    {
      "name": "Selectable Grid",
      "props": {
        "selectable": true
      }
    },
    {
      "name": "Grid with Toolbar & Search",
      "props": {
        "showToolbar": true,
        "toolbarTitle": "Users Directory",
        "showSearch": true,
        "searchPlaceholder": "Search users..."
      }
    },
    {
      "name": "Sortable Grid",
      "props": {
        "sortable": true,
        "sortMode": "table"
      }
    },
    {
      "name": "External Sort Grid",
      "props": {
        "sortable": true,
        "sortMode": "external"
      }
    },
    {
      "name": "Grid with Row Actions",
      "props": {
        "rowClickable": false,
        "rowActions": [
          {
            "key": "edit",
            "icon": "pencil",
            "tooltip": "Edit user"
          },
          {
            "key": "delete",
            "icon": "trash-2",
            "tooltip": "Delete user"
          },
          {
            "key": "reset-password",
            "icon": "key-round",
            "tooltip": "Reset password"
          }
        ]
      }
    },
    {
      "name": "Empty State grid",
      "props": {
        "items": [],
        "selectable": false
      }
    },
    {
      "name": "Grouped rows with preselection",
      "props": {
        "rowGroup": "role",
        "selectedKeys": [
          "2"
        ],
        "selectable": true,
        "twoLineRows": true
      }
    },
    {
      "name": "Custom gutter and status cell",
      "props": {
        "rowGutter": "custom"
      },
      "slots": {
        "q-data-table-row-gutter-string%3A1": "<span aria-label=\"Featured member\">★</span>",
        "q-data-table-cell-string%3Astatus-string%3A1": "<q-chip variant=\"success\" label=\"Active\"></q-chip>"
      }
    },
    {
      "name": "Loading records",
      "props": {
        "loading": true
      }
    },
    {
      "name": "Continued numbering",
      "props": {
        "rowGutter": "numbers",
        "rowNumberOffset": 20
      }
    }
  ]
}
