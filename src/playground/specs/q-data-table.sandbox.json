{
  "name": "Data Table",
  "tag": "q-data-table",
  "props": {
    "rowGutter": {
      "type": "select",
      "options": ["none", "blank", "numbers", "custom"],
      "default": "blank",
      "desc": "Structural leading cell; custom uses stable row-specific slots"
    },
    "rowNumberOffset": {
      "type": "number",
      "default": 0,
      "desc": "Nonnegative safe integer offset for displayed row numbers"
    },
    "selectable": {
      "type": "boolean",
      "default": false,
      "desc": "Enables row checkboxes and master selection header toggle"
    },
    "showToolbar": {
      "type": "boolean",
      "default": false,
      "desc": "Enables top toolbar layout with search, filters, and actions"
    },
    "showSearch": {
      "type": "boolean",
      "default": false,
      "desc": "Enables search text input in the toolbar"
    },
    "keyField": {
      "type": "string",
      "default": "id",
      "desc": "Unique field key representing each row identity"
    },
    "rowClickable": {
      "type": "boolean",
      "default": true,
      "desc": "Enables full-row click and keyboard activation"
    },
    "sortable": {
      "type": "boolean",
      "default": false,
      "desc": "Enables sortable headers for columns that do not opt out"
    },
    "sortMode": {
      "type": "select",
      "options": ["table", "external"],
      "default": "table",
      "desc": "Use table to sort provided items locally, or external to only emit sort changes"
    },
    "sortColumn": {
      "type": "string",
      "default": "",
      "desc": "Currently sorted column key"
    },
    "sortDirection": {
      "type": "select",
      "options": ["", "asc", "desc"],
      "default": "",
      "desc": "Current sort direction"
    },
    "toolbarTitle": {
      "type": "string",
      "default": "",
      "desc": "Title text displayed in the top-left section of the toolbar"
    },
    "searchPlaceholder": {
      "type": "string",
      "default": "Search...",
      "desc": "Placeholder text for the search input"
    },
    "columns": {
      "type": "textarea",
      "default": "[\n  { \"key\": \"id\", \"header\": \"ID\", \"width\": \"60px\" },\n  { \"key\": \"name\", \"header\": \"Name\", \"width\": \"1.5fr\" },\n  { \"key\": \"role\", \"header\": \"Role\" },\n  { \"key\": \"status\", \"header\": \"Status\" }\n]",
      "desc": "JSON array of table column definitions"
    },
    "items": {
      "type": "textarea",
      "default": "[\n  { \"id\": \"1\", \"name\": \"Administrator Account\", \"role\": \"Admin\", \"status\": \"Active\" },\n  { \"id\": \"2\", \"name\": \"Content Editor Manager\", \"role\": \"Editor\", \"status\": \"Inactive\" },\n  { \"id\": \"3\", \"name\": \"Viewer Guest\", \"role\": \"Viewer\", \"status\": \"Active\" }\n]",
      "desc": "JSON array of data row items"
    },
    "rowActions": {
      "type": "textarea",
      "default": "[]",
      "desc": "JSON array of row action definitions with key, icon, and tooltip"
    },
    "searchValue": {
      "type": "string",
      "default": "",
      "desc": "Current search input value"
    }
  },
  "slots": {
    "empty": {
      "type": "text",
      "default": "No items found in this section.",
      "desc": "Custom component fallback layout when rows are empty"
    },
    "footer": {
      "type": "html",
      "default": "<div style=\"padding: 0px 16px; font-size: 0.85rem; opacity: 0.7;\">Total entries: 3</div>",
      "desc": "Custom footer content slot (appends to table bottom)"
    },
    "toolbar-left": {
      "type": "text",
      "default": "",
      "desc": "Slot for elements rendered on the left of the toolbar (e.g. badges, counters)"
    },
    "filters": {
      "type": "text",
      "default": "",
      "desc": "Slot for filter elements (e.g. QDropdowns) rendered in the toolbar"
    },
    "actions": {
      "type": "text",
      "default": "",
      "desc": "Slot for action elements (e.g. buttons) rendered on the right of the toolbar"
    }
  },
  "variants": [
    {
      "name": "Numbered Rows",
      "props": {
        "rowGutter": "numbers",
        "rowNumberOffset": 0
      }
    },
    {
      "name": "No Row Gutter",
      "props": {
        "rowGutter": "none"
      }
    },
    {
      "name": "Standard Data Grid",
      "props": {
        "selectable": false
      }
    },
    {
      "name": "Selectable Grid",
      "props": {
        "selectable": true
      }
    },
    {
      "name": "Grid with Toolbar & Search",
      "props": {
        "showToolbar": true,
        "toolbarTitle": "Users Directory",
        "showSearch": true,
        "searchPlaceholder": "Search users..."
      }
    },
    {
      "name": "Sortable Grid",
      "props": {
        "sortable": true,
        "sortMode": "table"
      }
    },
    {
      "name": "External Sort Grid",
      "props": {
        "sortable": true,
        "sortMode": "external"
      }
    },
    {
      "name": "Grid with Row Actions",
      "props": {
        "rowClickable": false,
        "rowActions": "[\n  { \"key\": \"edit\", \"icon\": \"pencil\", \"tooltip\": \"Edit user\" },\n  { \"key\": \"delete\", \"icon\": \"trash-2\", \"tooltip\": \"Delete user\" },\n  { \"key\": \"reset-password\", \"icon\": \"key-round\", \"tooltip\": \"Reset password\" }\n]"
      }
    },
    {
      "name": "Empty State grid",
      "props": {
        "items": "[]",
        "selectable": false
      }
    }
  ]
}
