{
  "name": "Link",
  "tag": "q-link",
  "props": {
    "href": {
      "type": "string",
      "desc": "Direct destination. Omit to use url, mailto or tel.",
      "default": "#documentation"
    },
    "mailto": {
      "type": "string",
      "default": "",
      "desc": "Email address converted to a mailto target"
    },
    "tel": {
      "type": "string",
      "default": "",
      "desc": "Phone number converted to a tel target"
    },
    "target": {
      "type": "select",
      "options": [
        "",
        "_self",
        "_blank",
        "_parent",
        "_top"
      ],
      "default": "",
      "desc": "Anchor target"
    },
    "variant": {
      "type": "select",
      "options": [
        "default",
        "muted",
        "accent",
        "danger"
      ],
      "default": "default",
      "desc": "Text color variant"
    },
    "underline": {
      "type": "select",
      "options": [
        "hover",
        "always",
        "none"
      ],
      "default": "hover",
      "desc": "Underline behavior"
    },
    "external": {
      "type": "boolean",
      "default": false,
      "desc": "Shows the external-link indicator"
    },
    "disabled": {
      "type": "boolean",
      "default": false,
      "desc": "Disables navigation and click events"
    },
    "label": {
      "type": "string",
      "desc": "Fallback label when the default slot is empty"
    },
    "url": {
      "type": "string",
      "desc": "Deprecated fallback. Use href; omit the replacement to try this alias."
    },
    "rel": {
      "type": "string",
      "desc": "Link relationship tokens"
    },
    "download": {
      "type": "string",
      "desc": "Suggested filename when downloading the linked resource"
    }
  },
  "slots": {
    "default": {
      "type": "text",
      "default": "Open documentation",
      "desc": "Link label"
    },
    "icon-left": {
      "type": "html",
      "desc": "Before the label",
      "default": ""
    },
    "icon-right": {
      "type": "html",
      "desc": "After the label",
      "default": ""
    }
  },
  "variants": [
    {
      "name": "Default Link",
      "props": {
        "href": "#docs"
      },
      "slots": {
        "default": "Documentation"
      }
    },
    {
      "name": "Muted Link",
      "props": {
        "href": "#profile",
        "variant": "muted"
      },
      "slots": {
        "default": "Profile"
      }
    },
    {
      "name": "External Link",
      "props": {
        "href": "https://example.com",
        "target": "_blank"
      },
      "slots": {
        "default": "External resource"
      }
    },
    {
      "name": "Danger Link",
      "props": {
        "href": "#delete",
        "variant": "danger",
        "underline": "always"
      },
      "slots": {
        "default": "Delete item"
      }
    },
    {
      "name": "Fallback label and leading icon",
      "props": {
        "label": "Documentation",
        "href": "#documentation"
      },
      "slots": {
        "default": "",
        "icon-left": "<q-icon name=\"book-open\"></q-icon>"
      }
    },
    {
      "name": "Email",
      "props": {
        "mailto": "hello@example.com",
        "href": null
      },
      "slots": {
        "default": "Email support"
      }
    },
    {
      "name": "Telephone",
      "props": {
        "tel": "+12025550123",
        "href": null
      },
      "slots": {
        "default": "Call support"
      }
    },
    {
      "name": "Download illustration",
      "props": {
        "href": "assets/comparison-before.svg",
        "download": "landscape.svg"
      },
      "slots": {
        "default": "Download SVG"
      }
    },
    {
      "name": "External relationship",
      "props": {
        "href": "https://example.com",
        "target": "_blank",
        "rel": "external noopener noreferrer"
      },
      "slots": {
        "default": "Open resource",
        "icon-right": "↗"
      }
    }
  ],
  "edgeCases": [
    {
      "name": "Disabled Link",
      "props": {
        "href": "#disabled",
        "disabled": true
      },
      "slots": {
        "default": "Disabled link"
      }
    },
    {
      "name": "Long Link Text",
      "props": {
        "href": "#long"
      },
      "slots": {
        "default": "A very long link label that should still wrap naturally within its parent container"
      }
    },
    {
      "name": "Legacy URL fallback",
      "props": {
        "url": "#legacy",
        "href": null
      },
      "slots": {
        "default": "Legacy destination"
      }
    }
  ]
}
