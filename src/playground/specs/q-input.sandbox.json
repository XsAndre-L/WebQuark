{
  "name": "Input Field",
  "tag": "q-input",
  "props": {
    "width": {
      "type": "select",
      "default": "",
      "options": ["", "xs", "sm", "md", "lg", "xl", "xxl", "full"],
      "desc": "Horizontal width independent of size; empty preserves existing layout"
    },
    "type": {
      "type": "select",
      "options": [
        "text",
        "password",
        "email",
        "number",
        "url",
        "search",
        "color",
        "date",
        "datetime-local",
        "month",
        "time",
        "week"
      ],
      "default": "text",
      "desc": "Browser native input element type"
    },
    "size": {
      "type": "select",
      "default": "inherit",
      "options": [
        "inherit",
        "sm",
        "md",
        "lg"
      ],
      "desc": "Control size; inherit follows the nearest form or toolbar"
    },
    "clearable": {
      "type": "boolean",
      "default": false,
      "desc": "Displays clean icon button when value is populated"
    },
    "label": {
      "type": "string",
      "default": "Credential Login",
      "desc": "Floating input title label"
    },
    "placeholder": {
      "type": "string",
      "default": "Enter text here...",
      "desc": "Native placeholder text"
    },
    "value": {
      "type": "string",
      "default": "",
      "desc": "Active text content value"
    },
    "required": {
      "type": "boolean",
      "default": false,
      "desc": "Require a value for native form validation."
    },
    "disabled": {
      "type": "boolean",
      "default": false,
      "desc": "Disables typing and styles greyed state"
    },
    "error": {
      "type": "string",
      "default": "",
      "desc": "Swaps borders to red alert styles and shows text"
    },
    "labelHidden": {
      "type": "boolean",
      "default": false,
      "desc": "Keep the label accessible without displaying it"
    },
    "reserveFeedback": {
      "type": "boolean",
      "desc": "Reserve one feedback line; omit to inherit"
    },
    "ariaLabel": {
      "type": "string",
      "desc": "Accessible name for the native input when a visible label is not used."
    },
    "description": {
      "type": "string",
      "desc": "Supporting text, replaced by an active error."
    },
    "errorMessage": {
      "type": "string",
      "desc": "Deprecated fallback used when error is unset or empty."
    },
    "max": {
      "type": "number",
      "desc": "Upper bound for a numeric input."
    },
    "min": {
      "type": "number",
      "desc": "Lower bound for a numeric input."
    },
    "name": {
      "type": "string",
      "desc": "Name included in submitted form values."
    },
    "step": {
      "type": "number",
      "default": 1,
      "desc": "Numeric increment for spinner and validation."
    }
  },
  "slots": {
    "prefix": {
      "type": "html",
      "default": "",
      "desc": "Left element prefix content slot"
    },
    "suffix": {
      "type": "html",
      "default": "",
      "desc": "Right element suffix content slot"
    }
  },
  "variants": [
    {
      "name": "Standard Input Box",
      "props": {
        "label": "Full Name",
        "placeholder": "John Doe"
      }
    },
    {
      "name": "Small Input Box",
      "props": {
        "label": "Small Username",
        "placeholder": "sm-user",
        "size": "sm"
      }
    },
    {
      "name": "Large Input Box",
      "props": {
        "label": "Large Username",
        "placeholder": "lg-user",
        "size": "lg"
      }
    },
    {
      "name": "Color Picker Input",
      "props": {
        "label": "Accent Color Theme",
        "type": "color",
        "value": "#60a5fa"
      }
    },
    {
      "name": "Password type input",
      "props": {
        "label": "Security Password",
        "type": "password",
        "placeholder": "Enter code..."
      }
    },
    {
      "name": "Numeric Input",
      "props": {
        "label": "Quantity Bound",
        "type": "number",
        "value": "42",
        "placeholder": "Enter number...",
        "min": 0,
        "max": 100,
        "step": 2,
        "description": "Even values from 0 through 100."
      }
    },
    {
      "name": "Email with Error validation",
      "props": {
        "label": "Email Address",
        "type": "email",
        "value": "bad-email-format",
        "error": "Please enter a valid email address"
      }
    },
    {
      "name": "Disabled State lock",
      "props": {
        "label": "Hardware Address",
        "value": "00:1A:2B:3C:4D:5E",
        "disabled": true
      }
    },
    {
      "name": "Prefix Icon inline",
      "props": {
        "label": "Search query",
        "placeholder": "Type keywords..."
      },
      "slots": {
        "prefix": "<span style=\"padding:0 8px;opacity:0.6\">🔍</span>"
      }
    },
    {
      "name": "Suffix Label inline",
      "props": {
        "label": "Weight bounds",
        "placeholder": "0.00"
      },
      "slots": {
        "suffix": "<span style=\"padding:0 8px;opacity:0.6;font-size:0.8rem;font-weight:700\">kg</span>"
      }
    },
    {
      "name": "Prefix & Suffix & Clearable",
      "props": {
        "label": "Price (USD)",
        "clearable": true,
        "value": "99.95"
      },
      "slots": {
        "prefix": "<span style=\"padding:0 8px;opacity:0.6\">$</span>",
        "suffix": "<span style=\"padding:0 8px;opacity:0.6;font-size:0.8rem\">USD</span>"
      }
    },
    {
      "name": "Calendar date",
      "props": {
        "type": "date",
        "value": "2026-06-15",
        "label": "Due date"
      }
    },
    {
      "name": "Local appointment time",
      "props": {
        "type": "datetime-local",
        "value": "2026-06-15T09:30",
        "label": "Appointment"
      }
    },
    {
      "name": "Required hidden label",
      "props": {
        "required": true,
        "labelHidden": true,
        "label": "Username",
        "name": "username",
        "value": "",
        "description": "Enter a username to continue."
      }
    }
  ],
  "edgeCases": [
    {
      "name": "Extremely Long Value Text",
      "props": {
        "label": "Long value",
        "value": "This input has a super long value designed to verify horizontal scrolling inside the input field rather than breaking layout constraints."
      }
    },
    {
      "name": "Empty Placeholder & Label",
      "props": {
        "label": "",
        "placeholder": "",
        "ariaLabel": "Search records"
      }
    }
  ]
}
