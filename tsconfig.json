{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "allowUnreachableCode": false,
    "declaration": false,
    "experimentalDecorators": true,
    "lib": [
      "dom",
      "es2022"
    ],
    "moduleResolution": "bundler",
    "paths": {
      "@webquark/browser/formatters/runtime": ["./src/tooling/formatter/runtime.d.mts"]
    },
    "module": "esnext",
    "target": "es2022",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "rootDir": "./",
    "jsx": "react",
    "jsxFactory": "h",
    "jsxFragmentFactory": "h.Fragment",
    "types": [
      "@stencil/vitest/globals"
    ]
  },
  "include": [
    "src/browser"
  ],
  "exclude": [
    "node_modules"
  ]
}
